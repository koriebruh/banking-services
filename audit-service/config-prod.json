{
  "app": {
    "name": "audit-service"
  },
  "web": {
    "prefork": false,
    "port": 8085
  },
  "log": {
    "level": 6
  },
  "jwt": {
    "public_key_path": "secrets/public.pem"
  },
  "db": {
    "host": "audit-postgres",
    "port": 5432,
    "name": "${DB_NAME}",
    "username": "${DB_USERNAME}",
    "password": "${DB_PASSWORD}"
  },
  "telemetry": {
    "enabled": true,
    "endpoint": "otel-collector:4317"
  },
  "kafka": {
    "bootstrap": {
      "servers": "kafka:29092"
    },
    "consumer": {
      "group": "audit-service-group",
      "topics": "auth.events,account.events,transfer.events"
    }
  }
}