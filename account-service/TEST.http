}

### NEW CURRENT AKA GIRO
POST {{host}}/api/v1/accounts
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

{
  "account_type": "CURRENT"
}

### DEPOSIT
POST {{host}}/api/v1/accounts
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

{
  "account_type": "DEPOSIT",
  "deposit_detail": {
    "principal_amount": 500000000,
    "tenor_months": 12,
    "interest_payout": "MONTHLY",
    "auto_rollover": false
  }
}

### RDN
POST {{host}}/api/v1/accounts
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

{
  "account_type": "RDN",
  "rdn_detail": {
    "sid": "IDD123456789011",
    "securities_company": "PT Mandiri Sekuritas"
  }
}

### LIST MY ACCOUNT ───────────────────────────────────────────────────────────────
GET {{host}}/api/v1/accounts
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}


### GET DETAIL ACCOUNT BY ACCOUNT NUM  ────────────────────────────────────────────
@accountNum = 1187886263

GET {{host}}/api/v1/accounts/{{accountNum}}
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}


