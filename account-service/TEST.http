### NEW SAVINGS
POST {{host}}/api/v1/accounts
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

{
  "account_type": "SAVINGS"
}

### NEW CURRENT AKA GIRO
POST {{host}}/api/v1/accounts
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

{
  "account_type": "CURRENT"
}

### DEPOSIT
POST {{host}}/api/v1/accounts
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

{
  "account_type": "DEPOSIT",
  "deposit_detail": {
    "principal_amount": 500000000,
    "tenor_months": 12,
    "interest_payout": "MONTHLY",
    "auto_rollover": false
  }
}


### RDN
POST {{host}}/api/v1/accounts
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

{
  "account_type": "RDN",
  "rdn_detail": {
    "sid": "IDD123456789011",
    "securities_company": "PT Mandiri Sekuritas"
  }
}

### LIST MY ACCOUNT ───────────────────────────────────────────────────────────────
POST {{host}}/api/v1/accounts
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}


### GET DETAIL ACCOUNT BY ACCOUNT NUM  ────────────────────────────────────────────
@accountNum =

POST {{host}}/api/v1/accounts/{{accountNum}}
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}


### FREEZE ACCOUNT (ADMIN ONLY) BY ACC NUM  ───────────────────────────────────────
@accountNumberTarget =

PATCH {{host}}/api/v1/accounts/{{accountNumberTarget}}/status
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}


### LIST MUTATION TRASACTION  ─────────────────────────────────────────────────────
POST {{host}}/api/v1/accounts/{{accountNum}}/transactions
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}


### DETAIL HISOTRY TRASACTION BY ID ────────────────────────────────────────────────
@id =

POST {{host}}/api/v1/accounts/{{accountNum}}/transactions/{id}
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}
