{
  "app": {
    "name": "transfer-service"
  },
  "web": {
    "prefork": false,
    "port": 8083
  },
  "log": {
    "level": 6
  },
  "jwt": {
    "public_key_path": "secrets/public.pem"
  },
  "grpc": {
    "server": "account-service:9091"
  },
  "telemetry": {
    "enabled": true,
    "endpoint": "otel-collector:4317"
  },
  "database": {
    "username": "${DB_USERNAME}",
    "password": "${DB_PASSWORD}",
    "host": "${DB_HOST}",
    "port": 5432,
    "name": "${DB_NAME}",
    "pool": {
      "idle": 10,
      "max": 100,
      "lifetime": 300
    }
  },
  "kafka": {
    "bootstrap": {
      "servers": "kafka:29092"
    },
    "group": {
      "id": "transfer-service"
    },
    "auto": {
      "offset": {
        "reset": "earliest"
      }
    },
    "producer": {
      "enabled": true,
      "topic": "transfer.events"
    }
  }
}