@referenceId =TXN-20260411-d26888ca
@accountNumber = 5874967462

### Top Up
POST {{host}}/transfers/topup
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

{
  "target_account_number": "5874967462",
  "amount": "10000",
  "currency": "IDR",
  "description": "top up saldo"
}

### Initiate Transfer
POST {{host}}/transfers
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

{
  "source_account_number": "9240355345",
  "target_account_number": "5874967462",
  "amount": "500000",
  "source_currency": "IDR",
  "target_currency": "IDR",
  "description": "bayar utang"
}

### Confirm Transfer
POST {{host}}/transfers/{{referenceId}}/confirm
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

### Cancel Transfer
POST {{host}}/transfers/{{referenceId}}/cancel
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

{
  "reason": "salah input nominal"
}

### Get My Transfers
GET {{host}}/transfers
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

### Get My Transfers - dengan filter
GET {{host}}/transfers?status=COMPLETED&from=2026-01-01&to=2026-12-31&page=0&size=20
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

### Get Transfer Detail
GET {{host}}/transfers/{{referenceId}}
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

### Get Account History
GET {{host}}/transfers/accounts/{{accountNumber}}/history
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}

### Get Account History - dengan filter
GET {{host}}/transfers/accounts/{{accountNumber}}/history?from=2026-01-01&to=2026-12-31&page=0&size=20
Accept: application/json
Content-Type: application/json
X-Correlation-ID: {{correlationId}}
Authorization: Bearer {{accessToken}}